{% extends 'base.html.twig' %}

{% block title %}Timesheet{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.19/index.global.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fullcalendar/daygrid@6.1.19/index.global.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fullcalendar/timegrid@6.1.19/index.global.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid py-3">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between mb-3 gap-2">
    <div>
      <h1 class="h4 mb-1">Timesheet</h1>
      <p class="text-muted mb-0">Create and manage contracts used for monthly billing and signed timesheet reports.</p>
    </div>
    <div class="text-muted small">
      Billing cadence: <strong>Monthly</strong> · Signed timesheet report required.
    </div>
  </div>

  {% if error %}
    <div class="alert alert-warning" role="alert">{{ error }}</div>
  {% endif %}

  <ul class="nav nav-tabs" id="timesheetTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="contracts-tab" data-bs-toggle="tab" data-bs-target="#contracts-pane" type="button" role="tab" aria-controls="contracts-pane" aria-selected="true">
        Contracts
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="hours-tab" data-bs-toggle="tab" data-bs-target="#hours-pane" type="button" role="tab" aria-controls="hours-pane" aria-selected="false">
        Hours
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="report-tab" data-bs-toggle="tab" data-bs-target="#report-pane" type="button" role="tab" aria-controls="report-pane" aria-selected="false">
        Report
      </button>
    </li>
  </ul>

  <div class="tab-content pt-3" id="timesheetTabContent">
    <div class="tab-pane fade show active" id="contracts-pane" role="tabpanel" aria-labelledby="contracts-tab" tabindex="0">
      <div class="d-flex justify-content-end mb-2">
        <button
          type="button"
          class="btn btn-primary"
          data-contract-new
          data-bs-toggle="modal"
          data-bs-target="#contractModal"
          data-action-create="{{ path('timesheet_contract_create') }}"
        >
          New Contract
        </button>
      </div>

      <div class="card shadow-sm">
        <div class="card-header fw-semibold">Contracts</div>
        <div class="card-body p-0">
          {% if contracts is empty %}
            <div class="p-3 text-muted">No contracts yet.</div>
          {% else %}
            <div class="table-responsive">
              <table class="table table-sm table-striped align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Project</th>
                    <th>Supplier</th>
                    <th>PO</th>
                    <th>From</th>
                    <th>To</th>
                    <th class="text-end">Total Hours</th>
                    <th>Customer Approval Emails</th>
                    <th>Supplier Timesheet Receiver</th>
                    <th>Contract PDF</th>
                    <th class="text-end">Workload</th>
                    <th>Billing</th>
                    <th>Signed Report</th>
                    <th>Created</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for contract in contracts %}
                    <tr>
                      <td class="fw-semibold">{{ contract.projectName }}</td>
                      <td>{{ contract.supplier }}</td>
                      <td>{{ contract.poNumber ?: '—' }}</td>
                      <td>{{ contract.fromDate ? contract.fromDate|date('Y-m-d') : '—' }}</td>
                      <td>{{ contract.toDate ? contract.toDate|date('Y-m-d') : '—' }}</td>
                      <td class="text-end">{{ contract.totalHours ? contract.totalHours|number_format(2, '.', '') ~ ' h' : '—' }}</td>
                      <td class="text-muted small">{{ contract.customerApprovalEmails ?: '—' }}</td>
                      <td class="text-muted small">{{ contract.supplierTimesheetReceiverEmail ?: '—' }}</td>
                      <td>
                        {% if contract.contractPdfPath %}
                          <a href="/{{ contract.contractPdfPath }}" target="_blank" rel="noreferrer">View</a>
                        {% else %}
                          —
                        {% endif %}
                      </td>
                      <td class="text-end">{{ contract.workloadHoursWeek|number_format(2, '.', '') }} h/week</td>
                      <td>{{ contract.billingFrequency|capitalize }}</td>
                      <td>{{ contract.requiresSignedReport ? 'Yes' : 'No' }}</td>
                      <td class="text-muted">{{ contract.createdAt|date('Y-m-d') }}</td>
                      <td class="text-end">
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-secondary"
                          data-contract-edit
                          data-bs-toggle="modal"
                          data-bs-target="#contractModal"
                          data-action-update="{{ path('timesheet_contract_update', { id: contract.id }) }}"
                          data-project-name="{{ contract.projectName|e('html_attr') }}"
                          data-po-number="{{ contract.poNumber|default('')|e('html_attr') }}"
                          data-supplier="{{ contract.supplier|e('html_attr') }}"
                          data-workload="{{ contract.workloadHoursWeek|number_format(2, '.', '') }}"
                          data-from-date="{{ contract.fromDate ? contract.fromDate|date('Y-m-d') : '' }}"
                          data-to-date="{{ contract.toDate ? contract.toDate|date('Y-m-d') : '' }}"
                          data-total-hours="{{ contract.totalHours ? contract.totalHours|number_format(2, '.', '') : '' }}"
                          data-customer-approval-emails="{{ contract.customerApprovalEmails|default('')|e('html_attr') }}"
                          data-supplier-receiver-email="{{ contract.supplierTimesheetReceiverEmail|default('')|e('html_attr') }}"
                          data-contract-pdf="{{ contract.contractPdfPath|default('')|e('html_attr') }}"
                        >
                          Edit
                        </button>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="hours-pane" role="tabpanel" aria-labelledby="hours-tab" tabindex="0">
      {% set calendarContracts = [] %}
      {% for contract in contracts %}
        {% set calendarContracts = calendarContracts|merge([{
          id: contract.id,
          label: contract.projectName ~ ' · ' ~ contract.supplier
        }]) %}
      {% endfor %}
      {% set calendarHours = [] %}
      {% for entry in hours %}
        {% set calendarHours = calendarHours|merge([{
          id: entry.id,
          contractId: entry.contract ? entry.contract.id : null,
          contractLabel: entry.contract ? entry.contract.projectName ~ ' · ' ~ entry.contract.supplier : null,
          workDate: entry.workDate|date('Y-m-d'),
          hours: entry.hours,
          comment: entry.comment ?? '',
          category: entry.category ?? '',
          startTime: entry.startTime ? entry.startTime|date('H:i') : null,
          endTime: entry.endTime ? entry.endTime|date('H:i') : null
        }]) %}
      {% endfor %}

      <div class="row g-3">
        <div class="col-12 col-xl-8">
          <div class="card shadow-sm">
            <div class="card-header fw-semibold">Calendar</div>
            <div class="card-body">
              <div
                id="timesheet-calendar-root"
                data-contracts="{{ calendarContracts|json_encode|e('html_attr') }}"
                data-hours="{{ calendarHours|json_encode|e('html_attr') }}"
              ></div>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">Statistics</div>
            <div class="card-body">
              <form method="get" class="d-flex flex-column gap-2 mb-2">
                <div>
                  <label class="form-label small mb-1">Month</label>
                  <input
                    type="month"
                    name="statsMonth"
                    class="form-control form-control-sm"
                    value="{{ statsMonthLabel }}"
                  />
                </div>
              </form>
              {% if statsByCategory is empty %}
                <div class="text-muted">No hours logged this month.</div>
              {% else %}
                <ul class="list-unstyled mb-0">
                  {% for category, total in statsByCategory %}
                    <li class="d-flex justify-content-between">
                      <span>{{ category }}</span>
                      <span class="fw-semibold">{{ total|number_format(2, '.', '') }} h</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              <hr />
              <div class="fw-semibold mb-2">Monthly hours</div>
              <div class="text-muted small mb-2">All contracts</div>
              <div class="text-muted small mb-2">Billable = RemoteOffice + OnSite · Reportable = all categories</div>
              <canvas id="statsMonthlyChart" height="250" style="max-height: 250px;"></canvas>
            </div>
          </div>
          <div class="card shadow-sm">
            <div class="card-header fw-semibold">Log Hours</div>
            <div class="card-body">
              <form
                id="timesheet-hours-form"
                method="post"
                action="{{ path('timesheet_hours_create') }}"
                data-create-action="{{ path('timesheet_hours_create') }}"
                data-update-base="/timesheet/hours"
              >
                <div class="row g-3">
                  <input type="hidden" name="entryId" value="" />
                  <div class="col-12">
                    <label class="form-label">Contract</label>
                    <select name="contractId" class="form-select">
                      <option value="">Select contract</option>
                      {% for contract in contracts %}
                        <option value="{{ contract.id }}">{{ contract.projectName }} · {{ contract.supplier }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Start datetime</label>
                    <input type="datetime-local" name="startDateTime" class="form-control" required />
                  </div>
                  <div class="col-12">
                    <label class="form-label">End datetime</label>
                    <input type="datetime-local" name="endDateTime" class="form-control" required />
                  </div>
                  <div class="col-12">
                    <label class="form-label">Category</label>
                    <input type="text" name="category" class="form-control" />
                  </div>
                  <div class="col-12">
                    <label class="form-label">Comment (optional)</label>
                    <textarea name="comment" class="form-control" rows="3"></textarea>
                  </div>
                </div>
                <div class="d-flex justify-content-end mt-3">
                  <button
                    id="timesheet-hours-submit"
                    type="submit"
                    class="btn btn-primary"
                    data-edit-label="Update Hours"
                  >
                    Save Hours
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="report-pane" role="tabpanel" aria-labelledby="report-tab" tabindex="0">
      <div class="row g-3">
        <div class="col-12 col-xl-4">
          <div class="card shadow-sm">
            <div class="card-header fw-semibold">Monthly report</div>
            <div class="card-body">
              <form method="get" class="d-flex flex-column gap-2">
                <div>
                  <label class="form-label small mb-1">Month</label>
                  <input
                    type="month"
                    name="reportMonth"
                    class="form-control form-control-sm"
                    value="{{ reportMonthLabel }}"
                  />
                </div>
                <div>
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
                </div>
              </form>
              <div class="text-muted small">Billable = RemoteOffice + OnSite · Reportable = all categories</div>
            </div>
          </div>
        </div>
        <div class="col-12 col-xl-8">
          <div class="card shadow-sm">
            <div class="card-header fw-semibold">Approval</div>
            <div class="card-body p-0">
              {% if contracts is empty %}
                <div class="p-3 text-muted">No contracts yet.</div>
              {% else %}
                <div class="table-responsive">
                  <table class="table table-sm table-striped align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Contract</th>
                        <th class="text-end">Reportable</th>
                        <th class="text-end">Billable</th>
                        <th>Approved</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for contract in contracts %}
                        {% set totals = reportTotals[contract.id] ?? { reportable: 0, billable: 0 } %}
                        {% set approval = reportApprovals[contract.id] ?? null %}
                        <tr>
                          <td class="fw-semibold">{{ contract.projectName }} · {{ contract.supplier }}</td>
                          <td class="text-end">{{ totals.reportable|number_format(2, '.', '') }} h</td>
                          <td class="text-end">{{ totals.billable|number_format(2, '.', '') }} h</td>
                          <td class="text-muted small">
                            {% if approval %}
                              {{ approval.approvedAt|date('Y-m-d H:i') }}{% if approval.approvedBy %} · {{ approval.approvedBy }}{% endif %}
                            {% else %}
                              —
                            {% endif %}
                          </td>
                          <td class="text-end">
                            <form method="post" action="{{ path('timesheet_report_approve') }}">
                              <input type="hidden" name="contractId" value="{{ contract.id }}" />
                              <input type="hidden" name="reportMonth" value="{{ reportMonthLabel }}" />
                              <button type="submit" class="btn btn-sm btn-outline-primary">
                                {{ approval ? 'Re-approve' : 'Approve' }}
                              </button>
                            </form>
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="contractModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="contractModalTitle">New Contract</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form method="post" id="contractModalForm" action="{{ path('timesheet_contract_create') }}" enctype="multipart/form-data">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Project Name</label>
              <input type="text" name="projectName" class="form-control" required />
            </div>
            <div class="col-12">
              <label class="form-label">PO</label>
              <input type="text" name="poNumber" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label">Supplier</label>
              <input type="text" name="supplier" class="form-control" required />
            </div>
            <div class="col-12">
              <label class="form-label">Workload (hours / week)</label>
              <input type="number" step="0.25" min="0" name="workloadHoursWeek" class="form-control" required />
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label">From Date</label>
              <input type="date" name="fromDate" class="form-control" />
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label">To Date</label>
              <input type="date" name="toDate" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label">Total Hours</label>
              <input type="number" step="0.25" min="0" name="totalHours" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label">Customer Approval Emails</label>
              <textarea name="customerApprovalEmails" class="form-control" rows="2" placeholder="email1@company.com, email2@company.com"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label">Supplier Timesheet Receiver Email</label>
              <input type="email" name="supplierTimesheetReceiverEmail" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label">Contract PDF</label>
              <div id="contractPdfDropzone" class="border rounded p-3 text-center bg-light" style="cursor: pointer;">
                <input type="file" name="contractPdf" id="contractPdfInput" class="d-none" accept="application/pdf" />
                <div id="contractPdfHint" class="text-muted small">Drag &amp; drop PDF here or click to browse.</div>
                <a id="contractPdfLink" href="#" target="_blank" rel="noreferrer" class="d-none">View current PDF</a>
              </div>
            </div>
          </div>
          <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-primary">Save Contract</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contractModalForm');
    const title = document.getElementById('contractModalTitle');
    const inputProject = form.querySelector('input[name="projectName"]');
    const inputPo = form.querySelector('input[name="poNumber"]');
    const inputSupplier = form.querySelector('input[name="supplier"]');
    const inputWorkload = form.querySelector('input[name="workloadHoursWeek"]');
    const inputFromDate = form.querySelector('input[name="fromDate"]');
    const inputToDate = form.querySelector('input[name="toDate"]');
    const inputTotalHours = form.querySelector('input[name="totalHours"]');
    const inputCustomerEmails = form.querySelector('textarea[name="customerApprovalEmails"]');
    const inputSupplierReceiver = form.querySelector('input[name="supplierTimesheetReceiverEmail"]');
    const pdfInput = document.getElementById('contractPdfInput');
    const pdfDropzone = document.getElementById('contractPdfDropzone');
    const pdfLink = document.getElementById('contractPdfLink');
    const pdfHint = document.getElementById('contractPdfHint');

    const setPdfLink = (path) => {
      if (!pdfLink || !pdfHint) return;
      if (path) {
        const href = path.startsWith('/') ? path : `/${path}`;
        pdfLink.href = href;
        pdfLink.classList.remove('d-none');
        pdfHint.classList.add('d-none');
      } else {
        pdfLink.href = '#';
        pdfLink.classList.add('d-none');
        pdfHint.classList.remove('d-none');
      }
    };

    if (pdfDropzone && pdfInput) {
      pdfDropzone.addEventListener('click', () => pdfInput.click());
      ['dragenter', 'dragover'].forEach((evt) => {
        pdfDropzone.addEventListener(evt, (event) => {
          event.preventDefault();
          pdfDropzone.classList.add('border-primary');
        });
      });
      ['dragleave', 'drop'].forEach((evt) => {
        pdfDropzone.addEventListener(evt, (event) => {
          event.preventDefault();
          pdfDropzone.classList.remove('border-primary');
        });
      });
      pdfDropzone.addEventListener('drop', (event) => {
        const files = event.dataTransfer?.files;
        if (files && files.length > 0) {
          pdfInput.files = files;
        }
      });
    }

    document.querySelectorAll('[data-contract-edit]').forEach((button) => {
      button.addEventListener('click', () => {
        title.textContent = 'Edit Contract';
        form.setAttribute('action', button.getAttribute('data-action-update'));
        inputProject.value = button.getAttribute('data-project-name') || '';
        inputPo.value = button.getAttribute('data-po-number') || '';
        inputSupplier.value = button.getAttribute('data-supplier') || '';
        inputWorkload.value = button.getAttribute('data-workload') || '';
        inputFromDate.value = button.getAttribute('data-from-date') || '';
        inputToDate.value = button.getAttribute('data-to-date') || '';
        inputTotalHours.value = button.getAttribute('data-total-hours') || '';
        inputCustomerEmails.value = button.getAttribute('data-customer-approval-emails') || '';
        inputSupplierReceiver.value = button.getAttribute('data-supplier-receiver-email') || '';
        if (pdfInput) pdfInput.value = '';
        setPdfLink(button.getAttribute('data-contract-pdf') || '');
      });
    });

    document.querySelectorAll('[data-contract-new]').forEach((button) => {
      button.addEventListener('click', () => {
        title.textContent = 'New Contract';
        form.setAttribute('action', button.getAttribute('data-action-create'));
        inputProject.value = '';
        inputPo.value = '';
        inputSupplier.value = '';
        inputWorkload.value = '';
        inputFromDate.value = '';
        inputToDate.value = '';
        inputTotalHours.value = '';
        inputCustomerEmails.value = '';
        inputSupplierReceiver.value = '';
        if (pdfInput) pdfInput.value = '';
        setPdfLink('');
      });
    });

    const chartEl = document.getElementById('statsMonthlyChart');
    if (chartEl && window.Chart) {
      const labels = {{ statsMonthlyLabels|json_encode|raw }};
      const reportable = {{ statsMonthlyReportable|json_encode|raw }};
      const billable = {{ statsMonthlyBillable|json_encode|raw }};
      if (labels.length > 0) {
        new Chart(chartEl, {
          type: 'bar',
          data: {
            labels,
            datasets: [
              {
                label: 'Reportable hours',
                data: reportable,
                backgroundColor: 'rgba(13,110,253,0.6)',
                borderColor: '#0d6efd',
                borderWidth: 1,
              },
              {
                label: 'Billable hours',
                data: billable,
                backgroundColor: 'rgba(25,135,84,0.6)',
                borderColor: '#198754',
                borderWidth: 1,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { boxWidth: 10, boxHeight: 10 },
              },
            },
            scales: {
              x: {
                stacked: false,
                ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 6 },
              },
              y: {
                beginAtZero: true,
                title: { display: false },
                ticks: { maxTicksLimit: 4 },
              },
            },
          },
        });
      }
    }
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
{% endblock %}
