{% extends 'base.html.twig' %}

{% block title %}Les escapade de Colette{% endblock %}

{% block body %}
  <style>
    .colette-hero {
      background: linear-gradient(135deg, #f5f0e6, #e0e7da);
      border-radius: 18px;
      padding: 36px 32px;
      margin-bottom: 32px;
      box-shadow: 0 18px 40px rgba(61, 79, 90, 0.12);
      font-family: 'Georgia', serif;
      color: #2f3b3f;
    }

    .colette-hero h1 {
      margin: 0 0 12px 0;
      font-size: 38px;
      letter-spacing: 0.04em;
    }

    .colette-hero p {
      max-width: 720px;
      margin: 8px 0;
      font-size: 18px;
      line-height: 1.6;
    }

    .colette-section {
      margin-bottom: 42px;
    }

    .colette-section h2 {
      font-size: 26px;
      margin-bottom: 18px;
      font-weight: 600;
      color: #23424a;
    }

    .colette-grid {
      display: grid;
      gap: 20px;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .colette-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 22px;
      box-shadow: 0 12px 24px rgba(37, 54, 64, 0.08);
      border: 1px solid rgba(37, 54, 64, 0.08);
      font-family: 'Lato', sans-serif;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .colette-card h3 {
      margin: 0;
      font-size: 20px;
      color: #24323b;
    }

    .colette-subtitle {
      font-style: italic;
      color: #6b7a83;
      margin: 0;
    }

    .colette-content {
      font-size: 15px;
      line-height: 1.7;
      color: #2e363a;
      white-space: pre-wrap;
    }

    .colette-notes {
      margin: 0;
      font-size: 13px;
      color: #55626a;
      border-left: 3px solid #d6dac0;
      padding-left: 10px;
    }

    .colette-updated {
      margin-top: auto;
      font-size: 12px;
      color: #8b979f;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    @media (max-width: 640px) {
      .colette-hero {
        padding: 24px 18px;
      }

      .colette-hero h1 {
        font-size: 28px;
      }

      .colette-hero p {
        font-size: 16px;
      }
    }
  </style>

  <section class="colette-hero">
    <h1>Les escapade de Colette</h1>
    <p>
      Un carnet vivant de recettes solaires et de fragments de sagesse glanés au fil des voyages de Colette.
      Chaque page est une invitation à honorer les saisons, à soigner avec le simple et à cuisiner avec le coeur.
    </p>
    <p>
      Parcourez ces notes comme vous ouvririez un garde-manger ancien: avec curiosité, respect et l'envie
      de partager.
    </p>
    <p>
      <a href="{{ path('app_colette_new') }}">Proposer une nouvelle page</a>
    </p>
  </section>

  {% if entriesByCategory is empty %}
    <p>Aucun contenu n'est encore disponible. Revenez bientôt pour les découvertes de Colette.</p>
  {% else %}
    {% for category, entries in entriesByCategory %}
      <section class="colette-section">
        <h2>{{ categoryLabels[category] ?? category|capitalize }}</h2>
        <div class="colette-grid">
          {% for entry in entries %}
            <article class="colette-card">
              {% if entry.imageData and entry.imageMimeType %}
                <img src="data:{{ entry.imageMimeType }};base64,{{ entry.imageData }}" alt="Illustration pour {{ entry.title }}" style="border-radius: 12px; max-width: 100%;" />
              {% endif %}
              <h3>{{ entry.title }}</h3>
              {% if entry.subtitle %}
                <p class="colette-subtitle">{{ entry.subtitle }}</p>
              {% endif %}
              <div class="colette-content">{{ entry.content|e('html')|nl2br }}</div>
              {% if entry.sourceNotes %}
                <p class="colette-notes">{{ entry.sourceNotes|e('html')|nl2br }}</p>
              {% endif %}
              {% if entry.ocrExtract %}
                <p class="colette-notes">Suggestion OCR: {{ entry.ocrExtract|e('html')|nl2br }}</p>
              {% endif %}
              <p class="colette-updated">Mis à jour le {{ entry.updatedAt ? entry.updatedAt|date('d F Y') : '—' }}</p>
              <p class="colette-updated" style="text-transform:none; letter-spacing:normal;">
                <a href="{{ path('app_colette_edit', { slug: entry.slug }) }}">Modifier cette page</a>
              </p>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% endif %}
{% endblock %}
