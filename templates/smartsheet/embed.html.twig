<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Smartsheet</title>
    {{ encore_entry_link_tags('app') }}
    <style>
      .sf-toolbar,
      #sfToolbarMainContent,
      #sfToolbarClearer {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <div class="container-fluid py-3">
      <div id="smartsheet-pivot-root"></div>

      <noscript>
        <div class="alert alert-warning mt-3" role="alert">
          JavaScript is required to load the Smartsheet data explorer. Please enable JavaScript and reload the page.
        </div>
      </noscript>
    </div>

    {{ encore_entry_script_tags('app') }}
    <script>
      window.__repweb = window.__repweb || { flags: {
        MIGRATION_MANAGER_ENABLED: false,
        BLAUE_ELISE_ENABLED: false,
        PROGRESS_INDICATORS_ENABLED: false,
      } };
    </script>
  </body>
</html>
