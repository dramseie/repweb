{% extends 'base.html.twig' %}

{% block title %}Smartsheet{% endblock %}

{% block body %}
<div class="container-fluid py-3">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between mb-3 gap-2">
    <div>
      <h1 class="h4 mb-1">Smartsheet</h1>
      <p class="text-muted mb-0">
        Explore NiFi-provided workspaces and analyse task durations across sheets and sites.
      </p>
    </div>
    <div class="text-muted small">
      Data sources: <code>nifi.smartsteet_workspaces</code>, <code>nifi.smartsheet_sheets</code>, <code>nifi.sp_smartsheet_pivot_all</code>, <code>nifi.smartsheet_master_data</code>
    </div>
  </div>

  <div id="smartsheet-pivot-root"></div>

  <noscript>
    <div class="alert alert-warning mt-3" role="alert">
      JavaScript is required to load the Smartsheet data explorer. Please enable JavaScript and reload the page.
    </div>
  </noscript>
</div>
{% endblock %}
